# ============================================================================
# Antigravity Google Home Bridge Configuration (.env)
# ============================================================================

# --- Gemini & Google Antigravity SDK ---
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Set to true ONLY for Vertex AI Express Mode keys (requires aiplatform.googleapis.com + billing).
# Google AI Studio keys (AIza... or AQ...) use the Gemini Developer API: leave false.
GEMINI_USE_VERTEX=false

# Gemini Live model for full-duplex bidirectional audio (verified: gemini-3.8-live,
# gemini-3.1-flash-live-preview, gemini-2.5-flash-native-audio-latest)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck

# Antigravity SDK Workspace & Persistence
# Where the 24/7 Proxmox Antigravity agent runs commands, edits files, and stores memory
AGY_WORKSPACE_DIR=/opt/antigravity-workspace
AGY_SAVE_DIR=/var/lib/agy-home-bridge/conversations
AGY_APP_DATA_DIR=/var/lib/agy-home-bridge/brain
AGY_ENABLE_WRITE_TOOLS=true
AGY_ENABLE_SANDBOX=false

# Optional: Connect to a local running Antigravity Desktop / Language Server
ANTIGRAVITY_LS_ADDRESS=
ANTIGRAVITY_CSRF_TOKEN=

# --- Server Networking ---
# IMPORTANT: Set HOST_LAN_IP to your Proxmox LXC/VM LAN IP (e.g. 192.168.1.50)
# so Google Home speakers on your Wi-Fi can fetch streamed TTS / audio responses.
HOST_LAN_IP=
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765

# --- Google Home / Chromecast Multi-Room Settings ---
# Default Google Home speaker or speaker group name (e.g., "Office", "Kitchen", "Whole Home")
DEFAULT_CAST_ROOM=Whole Home
# Default output mode: "direct" (browser/earbuds), "cast" (Google Home speaker), or "both"
DEFAULT_AUDIO_ROUTING=both
# Static list of known Google Home speaker IPs (optional comma-separated fallback if mDNS is filtered)
KNOWN_CAST_HOSTS=

# --- Google Home Cloud-to-Cloud Smart Home Fulfillment ---
# Shared Bearer Token for Google Home Cloud-to-Cloud OAuth / Home Assistant webhooks
SMART_HOME_WEBHOOK_TOKEN=change-me-to-a-secure-token

# --- Proxmox Hardware Wireless Mic Daemon (e.g. DJI Mic Mini / Hollyland Lark M2 USB receiver) ---
HW_MIC_ENABLED=false
HW_MIC_DEVICE_INDEX=
HW_MIC_SAMPLE_RATE=16000
HW_MIC_VAD_THRESHOLD=0.018
HW_MIC_SILENCE_DURATION_SEC=1.1
