[Unit]
Description=Antigravity Google Home Live Voice Bridge (24/7 Proxmox Daemon)
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/antigravity-google-home-bridge
EnvironmentFile=/opt/antigravity-google-home-bridge/.env
ExecStart=/opt/antigravity-google-home-bridge/.venv/bin/agy-home-bridge serve --host 0.0.0.0 --port 8765
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
